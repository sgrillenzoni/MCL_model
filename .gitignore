# Files regenerated automatically by MATLAB / Simulink: not tracked

# Autosave and backup
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*
*.bak

# Simulink cache and code generation
*.slxc
slprj/
sccprj/
codegen/
*_grt_rtw/
*_ert_rtw/
*.mex*

# Large external data (download, see README)
data/pwdb_sim1/
*.his

# Simulation outputs: only the small calibration results are tracked
*.mat
!calibration/results/*.mat

# Operating system
Thumbs.db
desktop.ini
.DS_Store
